<launch>
  <!-- Launch RealSense D435 camera -->
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="align_depth"             value="true"/>
    <arg name="enable_color"            value="true"/>
    <arg name="enable_depth"            value="true"/>
    <arg name="enable_infra1"           value="false"/>
    <arg name="enable_infra2"           value="false"/>
    <arg name="enable_gyro"             value="false"/>
    <arg name="enable_accel"            value="false"/>
    <arg name="enable_pointcloud"       value="false"/> <!-- tiết kiệm tài nguyên -->
    <arg name="unite_imu_method"        value="none"/>
    <arg name="color_width"             value="320"/>
    <arg name="color_height"            value="240"/>
    <arg name="depth_width"             value="320"/>
    <arg name="depth_height"            value="240"/>
    <arg name="color_fps"               value="15"/>
    <arg name="depth_fps"               value="15"/>
  </include>

  <include file="$(find rtabmap_launch)/launch/rtabmap.launch">
    <arg name="rgb_topic" value="/camera/color/image_raw"/>
    <arg name="depth_topic" value="/camera/aligned_depth_to_color/image_raw"/>
    <arg name="camera_info_topic" value="/camera/color/camera_info"/>

  </include>
  <!-- Optional: rtabmapviz GUI nếu cần -->
  <!-- Uncomment nếu muốn mở GUI -->
<!--   
  <node name="rtabmapviz" pkg="rtabmap_ros" type="rtabmapviz" output="screen">
    <param name="frame_id" value="base_link"/>
    <remap from="rgb/image" to="/camera/color/image_raw"/>
    <remap from="depth/image" to="/camera/aligned_depth_to_color/image_raw"/>
    <remap from="rgb/camera_info" to="/camera/color/camera_info"/>
  </node> -->
 
</launch>
