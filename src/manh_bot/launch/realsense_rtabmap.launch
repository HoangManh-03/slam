<launch>
  <arg name="open_rviz"     default="true"/>
  <arg name="rtabmap_viz" default="true"/>
  <arg name="camera"   default="camera"/>

  <arg name="with_camera" default="true"/>
  <arg name="localization" default="false"/>
  <arg name="database_path" default="~/.ros/rtabmap.db"/>
  <arg     if="$(arg localization)" name="rtabmap_args" default=""/>
  <arg unless="$(arg localization)" name="rtabmap_args" default="-d"/>

  <include file="$(find manh_bot)/launch/camera.launch">
    <arg name="camera" value="$(arg camera)"/>
  </include>

  <group ns="rtabmap">

  <node pkg="rtabmap_sync" type="rgbd_sync" name="rgbd_sync" output="screen">
    <remap from="rgb/image"         to="/$(arg camera)/color/image_raw"/>
    <remap from="depth/image"       to="/$(arg camera)/aligned_depth_to_color/image_raw"/>
    <remap from="rgb/camera_info"   to="/$(arg camera)/color/camera_info"/>
    <remap from="depth/camera_info" to="/$(arg camera)/aligned_depth_to_color/camera_info"/>
    <remap from="rgbd_image"        to="rgbd_image"/>
  </node>

  <node name="rtabmap" pkg="rtabmap_slam" type="rtabmap" output="screen" args="$(arg rtabmap_args)">
    <param name="frame_id" type="string" value="$(arg camera)_link"/>
    <param name="subscribe_rgbd" type="bool" value="true"/>
    <param name="approx_sync" type="bool" value="true"/>
    <remap from="rgbd_image" to="rgbd_image"/> </node>

  <node if="$(arg rtabmap_viz)" pkg="rtabmap_viz" type="rtabmap_viz" name="rtabmap_viz" output="screen">
    <param name="approx_sync" type="bool" value="true"/>
    <remap from="rgbd_image" to="rgbd_image"/> </node>
  
  </group>

</launch>